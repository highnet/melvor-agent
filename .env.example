# Folder linked in the Creator Toolkit's Directory Link mode (Steam client only).
# The mod bundle, manifest and stylesheet are written here by `pnpm build`.
# Directory Link re-zips this folder on every game reload, so a rebuild still
# needs a manual game reload to take effect.
MELVOR_CT_DIR=

# Where the planner service keeps durable state: logs, journal, saves, dump.json.
MELVOR_AGENT_DATA=./data

# Planner service port. The mod and TUI both default to this.
PORT=8787

# Base URL the TUI polls. Only change this if PORT changed.
MELVOR_AGENT_URL=http://localhost:8787

# Phase 2. Not read by any Phase 1 code path — /plan makes no model calls yet.
ANTHROPIC_API_KEY=
