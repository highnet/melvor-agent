{
  "name": "melvor-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @melvor-agent/mod dev",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:api": "tsx scripts/gen-api-docs.ts",
    "docs:api:check": "tsx scripts/gen-api-docs.ts --check",
    "docs:coverage": "tsx scripts/gen-coverage.ts",
    "docs:coverage:check": "tsx scripts/gen-coverage.ts --check",
    "knowledge:dump": "tsx packages/knowledge/src/cli/verify-dump.ts",
    "planner": "pnpm --filter @melvor-agent/planner dev",
    "verify": "pnpm check && pnpm typecheck && node scripts/check-adapter-boundary.mjs && pnpm docs:api:check && pnpm docs:coverage:check && pnpm test",
    "release": "node --env-file=.env scripts/release-modio.mjs",
    "release:dry": "node --env-file=.env scripts/release-modio.mjs --dry-run",
    "release:check": "node --env-file=.env scripts/release-modio.mjs --check",
    "prepare": "husky",
    "tui": "pnpm --filter @melvor-agent/tui start",
    "coverage": "node scripts/coverage-report.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "esbuild": "^0.24.0",
    "husky": "^9.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
